model Recipe {
  id String @id @default(cuid())

  active        Boolean    @default(false)
  title         String
  description   String
  image         String?
  cuisineType   String?    @map("cuisine_type")
  difficulty    Difficulty @default(MEDIUM)
  prepTime      Int?       @map("prep_time")
  cookTime      Int        @map("cook_time")
  calories      Int?
  protein       Int?
  fats          Int?
  carbohydrates Int?
  fiber         Int?
  rating        Decimal?   @db.Decimal(3, 2)
  slug          String     @unique
  sourceUrl     String?    @map("source_url")
  yield         Int?
  authorName    String?    @map("author_name")

  ingredients  RecipeIngredient[]
  steps        RecipeStep[]
  comments     Comment[]
  likes        RecipeLike[]
  views        RecipeView[]
  tags         RecipeToRecipeTag[]
  userSchedule UserSchedule[]

  author     User      @relation(fields: [authorId], references: [id])
  authorId   String    @map("author_id")
  dishType   DishType? @relation(fields: [dishTypeId], references: [id])
  dishTypeId String?   @map("dish_type_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("recipes")
}

model DishType {
  id String @id @default(cuid())

  order Int
  title String?

  recipes Recipe[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dish_types")
}

model RecipeStep {
  id String @id @default(cuid())

  order       Int
  title       String
  description String
  imgUrl      String? @map("img_url")
  url         String?

  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId String @map("recipe_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("recipe_steps")
}

model RecipeIngredient {
  id String @id @default(cuid())

  unit     Unit
  quantity Decimal? @db.Decimal(8, 3)

  OrderItem OrderItem[]

  recipe       Recipe     @relation(fields: [recipeId], references: [id])
  recipeId     String     @map("recipe_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String     @map("ingredient_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model Ingredient {
  id String @id @default(cuid())

  image String?
  name  String   @unique
  price Decimal? @db.Decimal(10, 2)

  recipes RecipeIngredient[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ingredients")
}

model RecipeTag {
  id String @id @default(cuid())

  name String @unique

  recipes RecipeToRecipeTag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("recipe_tags")
}

model RecipeToRecipeTag {
  recipes     Recipe    @relation(fields: [recipeId], references: [id])
  recipeId    String    @map("recipe_id")
  recipeTag   RecipeTag @relation(fields: [recipeTagId], references: [id])
  recipeTagId String    @map("recipe_tag_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@id([recipeId, recipeTagId])
  @@map("recipe_to_recipe_tag")
}

enum Unit {
  // Метрические единицы (Вес)
  GRAM // г, грамм, граммы, гр
  KILOGRAM // кг, килограмм, килограмма

  // Метрические единицы (Объем)
  MILLILITER // мл, миллилитр, миллилитра
  LITER // л, литр, литра

  // Штучные и порционные меры
  PIECE // шт, штука, штуки, штук
  CLOVE // зубчик, зубчика, зубчиков (для чеснока)
  PINCH // щепотка, щепотки, на кончике ножа
  BUNCH // пучок, пучка, пучков (для зелени)
  TWIG // веточка, веточки, веточек (для зелени, томатов)
  LEAF // лист, листик, лавровый лист
  ROOT // корень, коренья (имбирь, хрен)
  TUBER // клубень (картофель)
  HEAD // кочан, головка (капуста, чеснок, лук)
  SLICE // долька, ломтик, кусочек
  POD // стручок (перец, горох)
  CAN // банка, баночка
  PACK // пачка, упаковка, пакет
  BAR // плитка (шоколад)
  CUBE // кубик (бульонный, лед)

  // Обиходные/Кухонные меры объема
  TEASPOON // ч. л., чайная ложка
  TABLESPOON // ст. л., столовая ложка
  DESSERTSPOON // дес. л., десертная ложка
  GLASS // стакан, стакана, фужер, чашка
  DROP // капля, капли, капель

  // Специфические / Абстрактные меры
  BY_TASTE // по вкусу
  TO_DESIRED_CONSISTENCY // до нужной консистенции / сколько уйдет (например, для муки)
  OPTIONAL // по желанию, опционально
  AS_NEEDED // по необходимости / сколько потребуется
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}
